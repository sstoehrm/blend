;; blend-template 0.11.0
;; Editing this template? Bump the version above (and tests/install-templates.test.sh), or installs keep the old copy.
;; Plan graph: the tasks of one blend:build run when their order isn't a straight line
;; (.blend/plan.edn, linked from .blend/plan.md; both gitignored, deleted when the build ends).
;; One node per task: :tN {:name "N. <title>" :type "task" :state :new :text "<one-line brief>"}
;; :state is :new, :in-progress, :done or :blocked (+ :reason "<why>").
;; Edge [:tA :tB] {:direction :-> :type "needs"}: B needs A done first.
{:nodes {:t1 {:name "1. Example task" :type "task" :state :new
              :text "what this task builds and how it is tested"}
         :t2 {:name "2. Example task" :type "task" :state :new
              :text "what this task builds and how it is tested"}}
 :edges {[:t1 :t2] {:direction :-> :type "needs"}}}
